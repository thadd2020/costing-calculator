# Copy to .env for local development. In production set these in SiteGround Site Tools
# (Node.js > Deployment Options > Environment variables), never in the repo.
NODE_ENV=development
PORT=3000

# Database. Leave DB_CLIENT unset locally to use a SQLite file in DATA_DIR.
# Production on SiteGround MUST use MySQL (each deploy runs from a fresh folder).
# DB_CLIENT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
DATA_DIR=./data

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# bcrypt hash of the owner's password, from: npm run set-password
ADMIN_PASSWORD_HASH=
