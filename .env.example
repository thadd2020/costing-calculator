# Copy to .env for local development. In production set these in SiteGround Site Tools.
NODE_ENV=development
PORT=3000
# Folder for the SQLite database. In production this MUST survive redeploys (see DEPLOY.md).
DATA_DIR=./data
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# bcrypt hash of the owner's password, from: npm run set-password
ADMIN_PASSWORD_HASH=
